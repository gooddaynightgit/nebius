# Nebius Token Factory (OpenAI-compatible)
# https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Optional. Default is the public Token Factory endpoint.
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model overrides. Defaults match the Token Factory catalog (checked 2026-09-21).
# Blank or whitespace is treated as unset and uses the catalog default (`envOr`).
# In Vercel, delete empty model env rows — empty string ≠ unset, and used to wipe
# Nemotron Super / Nano / Qwen instruct defaults. Do not set NEBIUS_*_MODEL to "".
NEBIUS_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Cookbook id for multimodal photos. Not in the public catalog snapshot.
# Unset or blank uses this default. Do not set an empty Vercel env row to “skip”.
NEBIUS_NANO_OMNI_MODEL=nvidia/nemotron-3-nano-omni
# YOURS step 1 — visual excavation. Default is MiniCPM-V (image2text, eu-north1,
# listed 2026-09-21). No Qwen VL id is in that catalog snapshot; Token Factory
# vision docs still show Qwen/Qwen2-VL-72B-Instruct — set that here if you have
# it. Blank uses the MiniCPM-V default, then Omni, then a text-only pass.
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
# YOURS step 2 — Nightly Reflection closer. Default is Kimi-K2.6 (image2text,
# public catalog 2026-09-21, us-central1). YOURS sends the photo plus the
# excavation, chosen joy, and optional caption. moonshotai/Kimi-K3 is also
# image2text; Kimi-K2.7-Code is text2text (coding). If you force a text-only
# id, the closer stays text-only. After multimodal Kimi: Qwen instruct, then
# Super. Mock only if every live path fails.
NEBIUS_STORY_MODEL=moonshotai/Kimi-K2.6
# Optional. Text2text Nightly Reflection if image2text Kimi cannot finish.
# NEBIUS_STORY_TEXT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Optional. Text-only photo excavation if vision fails — keep off the Kimi closer.
# NEBIUS_EXCAVATE_TEXT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Fallback if Ultra-3 is unavailable.
NEBIUS_ULTRA_FALLBACK_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
# Set to 1 to spend Ultra credits on last-night continuity.
NEBIUS_USE_ULTRA=0

# NVIDIA Sonic TTS via Token Factory — not listable in the public catalog
# (checked 2026-09-20). Leave empty to stub TTS and return story text.
# When Token Factory publishes a Sonic / Magpie speech id, set it here.
NEBIUS_SONIC_MODEL=
NEBIUS_SONIC_VOICE=Magpie-Multilingual.EN-US.Aria.Calm

# Nebius AI Cloud object storage (S3-compatible). If any of these are missing,
# captures and stories fall back to local JSON/files under DATA_DIR.
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_S3_REGION=eu-north1
NEBIUS_S3_BUCKET=
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
NEBIUS_S3_PREFIX=gooddaynight

# Local/dev fallback directory (gitignored). On Vercel this is ephemeral /tmp —
# do not rely on it in production. Use Vercel Blob or Nebius S3 instead.
DATA_DIR=.data

# Vercel Blob (recommended on Vercel). Creating a Blob store in the project
# Storage tab sets BLOB_READ_WRITE_TOKEN automatically. Private stores preferred.
# After deploy, GET /api/health?probe=storage should show blobProbe.ok=true.
BLOB_READ_WRITE_TOKEN=
# Set to public if your Blob store was created as public.
BLOB_ACCESS=private

# Shared secret so a Nebius Serverless Job can weave every vault at 21:00.
# UI "Weave now" uses the session cookie and does not need this.
WEAVE_CRON_SECRET=

# Public origin for nightly-job examples and for Payfast return_url, cancel_url,
# and notify_url ({APP_URL}/api/payfast/itn). On Vercel, VERCEL_URL is used when
# APP_URL is unset. Payfast must be able to reach the notify URL.
APP_URL=http://localhost:3000

# Email OTP (DynamoDB + SES). This is separate from the Blob/S3 entitlement store.
# Create a DynamoDB table (on-demand) before deploy:
#   aws dynamodb create-table \
#     --table-name gooddaynightauth \
#     --attribute-definitions AttributeName=email,AttributeType=S \
#     --key-schema AttributeName=email,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST \
#     --region "$AWS_REGION"
#   aws dynamodb update-time-to-live \
#     --table-name gooddaynightauth \
#     --time-to-live-specification "Enabled=true, AttributeName=expiresAt" \
#     --region "$AWS_REGION"
# Partition key `email` is the normalized address. Attributes written by the app:
# codeHash (string, SHA-256 only), expiresAt (number, unix seconds, TTL),
# attempts (number), used (boolean), issues (list of unix seconds).
# The 6-digit code is emailed and never stored.
# IAM for the Vercel access key: dynamodb:GetItem, PutItem, UpdateItem on this
# table, and ses:SendEmail. SES_NOREPLY must be a verified identity in AWS_REGION.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Use only if the key above is temporary.
# AWS_SESSION_TOKEN=
# Verified SES from-address, for example GoodDayNight <noreply@gooddaynight.com>
SES_NOREPLY=
# Optional override. Default table name is gooddaynightauth.
AUTH_TABLE=gooddaynightauth
# Signs the httpOnly gdn_otp cookie. Required in production. Use a long random secret.
# The cookie lasts 12 hours (override with OTP_SESSION_TTL_SECONDS, 60–86400).
# After it expires, checkout and personal photos ask for a new code. Joy picks stay free.
# gdn_em alone does not open personal photos.
OTP_SESSION_SECRET=
# OTP_SESSION_TTL_SECONDS=43200

# Payfast checkout + ITN. Never commit real merchant secrets.
# SANDBOX defaults to false when unset: live www.payfast.co.za.
# This R5 test charges 5.00 ZAR and still credits 40 moment saves.
# The /moments page keeps showing R450 ZAR · $28 USD.
# Vercel Preview must use the live PF_MERCHANT_ID, PF_MERCHANT_KEY, and
# PF_PASSPHRASE with SANDBOX=false (or leave SANDBOX unset).
# Set SANDBOX=true only for sandbox.payfast.co.za, and only with sandbox keys.
# Do not mix live and sandbox secrets.
SANDBOX=false
PF_MERCHANT_ID=
PF_MERCHANT_KEY=
PF_PASSPHRASE=
