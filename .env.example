# Nebius Token Factory (OpenAI-compatible)
# https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Optional. Default is the public Token Factory endpoint.
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model overrides. Defaults match the Token Factory catalog (checked 2026-09-21).
NEBIUS_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Cookbook id for multimodal photos. Not in the public catalog snapshot — leave
# set to try Omni, or blank to skip and use Nano text-only ingest.
NEBIUS_NANO_OMNI_MODEL=nvidia/nemotron-3-nano-omni
# YOURS step 1 — visual excavation. Default is MiniCPM-V (image2text, eu-north1,
# listed 2026-09-21). No Qwen VL id is in that catalog snapshot; Token Factory
# vision docs still show Qwen/Qwen2-VL-72B-Instruct — set that here if you have
# it. Blank falls through to NEBIUS_NANO_OMNI_MODEL, then a text-only pass.
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
# YOURS step 2 — bedtime storyteller. Strong Qwen instruct; falls back to Super.
NEBIUS_STORY_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Fallback if Ultra-3 is unavailable.
NEBIUS_ULTRA_FALLBACK_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
# Set to 1 to spend Ultra credits on last-night continuity.
NEBIUS_USE_ULTRA=0

# NVIDIA Sonic TTS via Token Factory — not listable in the public catalog
# (checked 2026-09-20). Leave empty to stub TTS and return story text.
# When Token Factory publishes a Sonic / Magpie speech id, set it here.
NEBIUS_SONIC_MODEL=
NEBIUS_SONIC_VOICE=Magpie-Multilingual.EN-US.Aria.Calm

# Nebius AI Cloud object storage (S3-compatible). If any of these are missing,
# captures and stories fall back to local JSON/files under DATA_DIR.
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_S3_REGION=eu-north1
NEBIUS_S3_BUCKET=
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
NEBIUS_S3_PREFIX=gooddaynight

# Local/dev fallback directory (gitignored). On Vercel this is ephemeral /tmp —
# do not rely on it in production. Use Vercel Blob or Nebius S3 instead.
DATA_DIR=.data

# Vercel Blob (recommended on Vercel). Creating a Blob store in the project
# Storage tab sets BLOB_READ_WRITE_TOKEN automatically. Private stores preferred.
BLOB_READ_WRITE_TOKEN=
# Set to public if your Blob store was created as public.
BLOB_ACCESS=private

# Shared secret so a Nebius Serverless Job can weave every vault at 21:00.
# UI "Weave now" uses the session cookie and does not need this.
WEAVE_CRON_SECRET=

# Public origin used in the job script example.
APP_URL=http://localhost:3000
